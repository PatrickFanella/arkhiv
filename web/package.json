{
  "name": "@subculture/vhness-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build && vite build --ssr src/entry-prerender.tsx --outDir dist-ssr",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run src",
    "predev": "pnpm --dir .. build:packages",
    "prebuild": "pnpm --dir .. build:packages",
    "seo:render": "node scripts/prerender.mjs"
  },
  "dependencies": {
    "@subcult/archive-viewer": "workspace:*",
    "pdfjs-dist": "5.4.624",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.19.1",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.3",
    "vite": "^7.2.7",
    "vitest": "^4.0.8"
  }
}
